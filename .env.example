# Copy to .env, then replace with a random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHAT_MODEL=deepseek-flash
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# For running Flask outside Compose, set a MySQL URL explicitly:
# DATABASE_URL=mysql://campusclaw:password@127.0.0.1:3306/campusclaw
QDRANT_URL=http://127.0.0.1:6333
SEARCH_MAX_RESULTS=20
# Optional administrator-configured stdio MCP command as a JSON array.
# Empty uses the bundled independent calculator/current_time MCP process.
MCP_SERVER_COMMAND=
MCP_ALLOWED_TOOLS=calculator,current_time
